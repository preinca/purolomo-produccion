# Copia este archivo a .env.local y rellena los valores.
# En Vercel ponlos en Settings > Environment Variables.

# Base de datos de Supabase (Postgres).
# Supabase > botón "Connect" (arriba) > "Transaction pooler" (puerto 6543).
# Cambia [YOUR-PASSWORD] por la contraseña de la base de datos del proyecto.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Secreto para firmar las sesiones. OBLIGATORIO en producción: sin él cualquiera
# que conozca el código podría fabricar una sesión de administrador.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESION_SECRETO=
