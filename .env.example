# Copia este archivo a .env.local si quieres cambiar la ruta de SQLite.
# Si no lo pones, la app usa data/produccion.sqlite dentro de esta carpeta.

# Windows (ejemplo):
# SQLITE_PATH=C:\Users\TuUsuario\Documents\purolomo\produccion.sqlite

# macOS / Linux (ejemplo):
# SQLITE_PATH=/home/tu-usuario/Documentos/purolomo/produccion.sqlite

# Respaldo temporal de la demo en Supabase Storage (Supabase > Project Settings > API).
# Ponlos en .env.local para `npm run demo:subir` y en el panel Environment de Render.
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=demo-sqlite
# SUPABASE_OBJETO=produccion.sqlite
